# ========== SERVER ==========
PORT=3000
NODE_ENV=development

# ========== DATABASE ==========
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notification_aggregator
DB_USER=admin
DB_PASSWORD=mysecretpassword

# ========== GOOGLE OAUTH ==========
GOOGLE_CLIENT_ID=your_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=your_GOOGLE_CLIENT_SECRET
GOOGLE_LOGIN_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_ACCOUNT_CALLBACK_URL=http://localhost:3000/api/accounts/link/google/callback

# ========== MICROSOFT OAUTH ==========
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_ACCOUNT_CALLBACK_URL=http://localhost:3000/api/accounts/link/outlook/callback

# ========== JWT ==========
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production # Mã hóa JWT
JWT_EXPIRES_IN=7d

# ========== SESSION ==========
SESSION_SECRET=your_session_secret_change_this_in_production

# ========== FRONTEND ==========
FRONTEND_URL=http://localhost:5173

# ========== ENCRYPTION ==========
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_ENCRYPTION_KEY # Mã hóa data

# Pull email từ Google
ENABLE_EMAIL_POLLING=true
POLL_INTERVAL_MS=300000   # 5 phút
#POLL_INTERVAL_MS=3600000 # 10h

GEMINI_API_KEY=your_GEMINI_API_KEY
#GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODEL=gemini-3.1-flash-lite

# ─── News Scraper (HUST CTT) ─────────────────────────────────
# Interval cào tin (ms). Mặc định 1 giờ. Đặt thấp hơn khi dev/test.
NEWS_SCRAPE_INTERVAL_MS=3600000

# Số bài tối đa mỗi lần tick (1-100). Trang chủ HUST có ~10 bài unique sau dedup.
NEWS_SCRAPE_LIMIT=50

# true = re-fetch cả bài đã có content (nặng, dùng khi muốn refresh cứng).
# false = chỉ cào bài mới hoặc bài có content rỗng.
NEWS_SCRAPE_REFETCH=false

# false = tắt scheduler (vd khi chạy nhiều instance, chỉ 1 instance nên cào).
NEWS_SCRAPE_ENABLED=true

# ─── Attachment text extraction ─────────────────────────────────
# Danh sách extension file mà AI có thể đọc text qua tool read_attachment.
# Format: comma-separated, lowercase, KHÔNG có dấu chấm dẫn.
# Phải nằm trong tập extractByMime() ở attachmentTextService.js xử lý được:
#   pdf, docx, xlsx, xls, csv, html, htm, txt, md, json, xml, log
# File ngoài danh sách (vd ảnh/video/audio) sẽ bị giấu khỏi system instruction
# của AI để AI không cố gắng đọc rồi fail.
ATTACHMENT_TEXT_EXTRACT_EXTS=pdf,docx,xlsx,xls,csv,html,htm,txt,md,json,xml,log

# ─── Tavily Search — MỚI 2026-06 ─────────────────────────────────
# Dùng cho AI tool `web_search` (tra web trong AI Chat khi user hỏi
# thông tin thời sự / kiến thức ngoài hệ thống HUST).
#
# Tại sao Tavily (không phải Google Custom Search): Google đã đóng
# Custom Search JSON API cho user mới, sunset 2027-01-01. Tavily là
# search API build chuyên cho LLM — trả content đã extract sẵn, sạch
# hơn snippet thuần của Google, free 1,000 query/tháng, không cần
# credit card.
#
# Setup:
#   1. Đăng ký tại https://app.tavily.com (email hoặc Google/GitHub OAuth).
#   2. Sau khi sign in, dashboard hiện ngay API key dạng `tvly-...`.
#   3. Copy key → dán vào TAVILY_API_KEY bên dưới.
#
# Free tier: 1,000 credit/tháng, mỗi search "basic" tốn 1 credit.
# Nếu vượt → tool trả error 429 và AI tự fallback.
# Nếu để TRỐNG → tool web_search báo "chưa cấu hình" rồi AI fallback
# sang kiến thức nội tại (không crash).
TAVILY_API_KEY=
